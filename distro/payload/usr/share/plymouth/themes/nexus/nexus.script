# NEXUS OS boot splash: wordmark, progress bar, spinner dots.
Window.SetBackgroundTopColor(0.03, 0.05, 0.09);
Window.SetBackgroundBottomColor(0.01, 0.02, 0.04);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40);

bar.w = Math.Int(Window.GetWidth() * 0.28);
bar.h = 4;
bar.x = Window.GetWidth() / 2 - bar.w / 2;
bar.y = Window.GetHeight() / 2 + 90;

track.image  = Image("progress-track.png").Scale(bar.w, bar.h);
track.sprite = Sprite(track.image);
track.sprite.SetX(bar.x); track.sprite.SetY(bar.y);

fill.image = Image("progress-fill.png");

fun refresh_progress(progress) {
  w = Math.Int(bar.w * progress);
  if (w < 1) w = 1;
  fill.sprite = Sprite(fill.image.Scale(w, bar.h));
  fill.sprite.SetX(bar.x);
  fill.sprite.SetY(bar.y);
  fill.sprite.SetZ(1);
}

Plymouth.SetBootProgressFunction(fun (duration, progress) { refresh_progress(progress); });

message.sprite = Sprite();
message.sprite.SetPosition(Window.GetWidth() / 2 - 200, bar.y + 24, 2);
fun message_callback(text) {
  message.image = Image.Text(text, 0.62, 0.72, 0.85, 1, "Inter 10");
  message.sprite.SetImage(message.image);
}
Plymouth.SetMessageFunction(message_callback);
Plymouth.SetUpdateStatusFunction(message_callback);

# Password prompt for encrypted installs
fun display_password_callback(prompt, bullets) {
  message_callback(prompt + " " + bullets);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(fun () { message_callback(""); });
