# NEXUS OS update channel — copy to /etc/apt/sources.list.d/nexus.sources and
# point URIs at the APT repo you publish nexus-shell .debs to (the CI release
# workflow builds it; a local copy comes from dpkg-scanpackages + apt-ftparchive).
Types: deb
URIs: https://updates.example.org/nexus/stable/
Suites: stable
Components: main
Architectures: amd64
Signed-By: /usr/share/keyrings/nexus-archive-keyring.gpg
